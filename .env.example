# Provider Selection: 'ollama' (free local), 'groq' (free cloud API), 'gemini' (free cloud API), or 'watsonx'
LLM_PROVIDER=ollama

# Local Ollama Configuration (100% Free - No API Key Needed!)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# Free Cloud API Option 1: Groq (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Free Cloud API Option 2: Google Gemini (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# IBM Watsonx AI Configuration
IBM_WATSONX_APIKEY=your_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=skills-network
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Server Settings
PORT=5000
HOST=0.0.0.0

# Clerk Authentication Configuration (Get your publishable key at https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Stripe Payment Method Configuration (Get keys from https://dashboard.stripe.com)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
